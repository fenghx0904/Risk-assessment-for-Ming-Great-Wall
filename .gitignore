# Prevent accidental publication of credentials or local settings
.env
.env.*
*credential*
*credentials*
*password*
*token*
*ftp_download*.txt

# Excel workbooks are ignored unless explicitly tracked below
*.xlsx
!data/processed/analysis_input.xlsx

# Office temporary files and local copies
~$*
*-副本.xlsx
* - 副本.xlsx
*.before_*.py

